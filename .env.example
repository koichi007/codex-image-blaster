# World Labs Marble generates the explorable static 3D space.
# Required for world generation. Provider usage may be billed by World Labs.
WORLD_LABS_API_KEY=your_world_labs_key_here

# FAL is used for clean plates, prompt-based image edits, Hunyuan/Meshy-style
# object model generation, and ElevenLabs-style SFX. Provider usage may be
# billed by FAL and by the underlying model providers.
FAL_KEY=your_fal_key_here
